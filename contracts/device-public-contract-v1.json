        }
      }
    },
    {
      "name": "image_preview",
      "description": "Load a bounded image preview from one explicit owned online device for visual inspection.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1,
            "description": "Owned online device containing the image."
          },
          "path": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "sourcePath": {
            "type": "string"
          },
          "embed": {
            "type": "boolean",
            "default": true
          },
          "includeImage": {
            "type": "boolean",
            "default": true
          },
          "includeData": {
            "type": "boolean",
            "default": true
          },
          "maxBytes": {
            "type": "number",
            "default": 8388608
          }
        },
        "required": [
          "device_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "riskLevel": "low",
        "category": "filesystem",
        "profileVisibility": {
          "safe": true,
          "assisted": true,
          "yolo": true
        }
      }
    },
    {
      "name": "project_inspect",
      "description": "Inspect one configured project through bounded summary, tree, Git, README, or package views. Use read_text_file for generic file bodies.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1,
            "description": "Owned online device id associated with the project."
          },
          "project_id": {
            "type": "string",
            "description": "Configured project id on that device."
          },
          "view": {
            "type": "string",
            "enum": [
              "summary",
              "tree",
              "git_status",
              "git_diff",
              "readme",
              "package"
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 3
          },
          "staged": {
            "type": "boolean",
            "default": false
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor returned by a bounded tree page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 200
          }
        },
        "required": [
          "device_id",
          "project_id",
          "view"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "tool": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "ok",
          "tool",
          "summary",
          "data"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
