# Used by direct Node wrapper runs. uv run main.py defaults to the current directory unless --repo is passed.
REPO_ROOT=.
MCP_DEFAULT_PROJECT_ID=
MCP_REQUIRE_PROJECT_ID=false
MCP_ENABLE_PROJECT_PATH_INFERENCE=true
MCP_EXPOSE_PROJECT_PATHS=false
MCP_DEBUG_AUTH=false
MCP_SLOW_TOOL_MS=5000
# Optional override for the unified MCP config. Leave empty to use config/mcp-servers.toml.
MCP_UPSTREAM_CONFIG=
MCP_EXTERNAL_MCP_ENABLED=true
# Used by direct Node wrapper runs. uv run main.py defaults to 127.0.0.1:8101 unless --ip/--port are passed.
MCP_GATEWAY_HOST=127.0.0.1
MCP_ADVERTISE_HOST=
# Optional stable public HTTPS base URL for OAuth metadata when one is provided outside this repo.
MCP_ADVERTISE_URL=
MCP_GATEWAY_PORT=8101
ENABLE_FILESYSTEM=true
ENABLE_SHELL=true
# yolo is the default private local-dev profile. safe exposes read-only tools; assisted hides shell/open-world tools.
MCP_RUNTIME_PROFILE=yolo
XAI_API_KEY=
# Optional operator/static bearer credential. Normal human OAuth login uses account sessions.
MCP_BEARER_TOKEN=
# One-time device enrollment secret. Reconnect uses persisted Ed25519 proof-of-possession and does not need this token.
MCP_DEVICE_ENROLLMENT_TOKEN=
# Deny-by-default remote device ACL. JSON: {"rules":[{"callers":[...],"devices":[...],"tools":[...],"roots":[...]}]}
MCP_DEVICE_ACCESS_POLICY=
# Optional metadata-only debug exports. gateway.sqlite is authoritative; file exports are off by default.
MCP_METRICS_ENABLED=false
MCP_DEVICE_AUDIT_ENABLED=false