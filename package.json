{
  "name": "personal-mcp-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Windows-first launcher for a local filesystem MCP server exposed to ChatGPT Developer Mode through ngrok or Tailscale Funnel.",
  "license": "UNLICENSED",
  "scripts": {
    "start:stack": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-mcp-stack.ps1",
    "stop:stack": "powershell -ExecutionPolicy Bypass -File .\\scripts\\stop-mcp-stack.ps1",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@modelcontextprotocol/server-filesystem": "2026.1.14",
    "express": "5.1.0",
    "mcp-proxy": "6.4.6"
  }
}
