{
  "name": "agent-mcp-gateway",
  "version": "1.0.4",
  "description": "Cross-platform local MCP gateway for coding agents.",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/authenticated-mcp-wrapper.mjs",
    "start:live": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -ExecutionPolicy Bypass -File .\\scripts\\start-mcp-live.ps1",
    "stop:live": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -ExecutionPolicy Bypass -File .\\scripts\\stop-mcp-live.ps1",
    "test": "node --test tests/*.test.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "smoke:mcp": "node scripts/smoke-mcp-endpoint.mjs",
    "smoke:mcp-schemas": "node scripts/smoke-mcp-schemas.mjs",
    "smoke:mcp:tools": "node scripts/smoke-mcp-tools.mjs",
    "smoke:mcp:upstreams": "node scripts/smoke-mcp-upstreams.mjs",
    "benchmark:catalog": "node scripts/benchmark-mcp-catalog.mjs",
    "contract:device:check": "node scripts/check-device-public-contract.mjs",
    "device:revoke": "node scripts/device-admin.mjs revoke",
    "device:rotate": "node scripts/device-admin.mjs rotate",
    "device:enroll": "node scripts/device-admin.mjs enroll",
    "admin:account:create": "node scripts/admin.mjs account create-admin",
    "admin:account:list": "node scripts/admin.mjs account list",
    "admin:account:revoke": "node scripts/admin.mjs account revoke",
    "admin:account:delete": "node scripts/admin.mjs account delete",
    "admin:invite:create": "node scripts/admin.mjs invite create",
    "admin:invite:list": "node scripts/admin.mjs invite list",
    "admin:invite:revoke": "node scripts/admin.mjs invite revoke"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cors": "^2.8.6",
    "express": "5.1.0",
    "express-rate-limit": "^8.7.0",
    "smol-toml": "^1.4.2",
    "ws": "^8.21.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  }
}
