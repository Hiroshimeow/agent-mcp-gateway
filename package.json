{
  "name": "agent-mcp-gateway",
  "version": "1.0.0",
  "description": "Windows-first local MCP gateway for AI agents.",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/authenticated-mcp-wrapper.mjs",
    "start:live": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-mcp-live.ps1",
