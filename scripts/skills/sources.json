    {
      "id": "anthropic",
      "repository": "https://github.com/anthropics/skills.git",
      "ref": "main",
      "skillRoot": "skills",
      "license": "Apache-2.0 per included skill",
      "include": [
        "algorithmic-art",
        "brand-guidelines",
        "claude-api",
        "frontend-design",
        "internal-comms",
        "mcp-builder",
        "skill-creator",
        "slack-gif-creator",
        "theme-factory",
        "web-artifacts-builder",
        "webapp-testing"
      ],
      "overrides": {
        "frontend-design": {
          "description": "Use when designing, building, or materially reshaping a web or application UI that needs visual direction, typography, layout, responsive behavior, interaction design, or implementation-level aesthetic decisions."
        },
        "theme-factory": {
          "description": "Use when applying or generating a coherent visual theme for slides, documents, reports, or standalone artifacts whose content and structure already exist."
        },
        "web-artifacts-builder": {
          "description": "Use when implementing a complex interactive HTML artifact with React, Tailwind CSS, shadcn/ui, routing, or state management after its requirements and visual direction are established."
        }
      },
      "requireSkillLicense": {
        "path": "LICENSE.txt",
        "contains": "Apache License"
      },
      "rootFiles": [
        {
          "path": "THIRD_PARTY_NOTICES.md",
          "target": "anthropic-THIRD_PARTY_NOTICES.md"
        }
      ],
      "excluded": {
        "canvas-design": "Not vendored because its directory contains bundled font files.",
        "doc-coauthoring": "No redistributable license is declared in the skill directory.",
        "docx": "Anthropic source-available proprietary license prohibits redistribution.",
        "pdf": "Anthropic source-available proprietary license prohibits redistribution.",
        "pptx": "Anthropic source-available proprietary license prohibits redistribution.",
        "xlsx": "Anthropic source-available proprietary license prohibits redistribution."
      }
    },
    {
      "id": "stitch-design",
      "repository": "https://github.com/google-labs-code/stitch-skills.git",
      "ref": "main",
      "skillRoot": "plugins/stitch-design/skills",
      "license": "Apache-2.0",
      "requireRootLicense": {
        "path": "LICENSE",
        "contains": "Apache License"
      },
      "include": [
        "extract-design-md"
      ],
      "overrides": {
        "extract-design-md": {
          "aliases": [
            "extract_design_system",
            "design_extraction"
          ],
          "description": "Use when analyzing an existing frontend source tree to extract design tokens, component conventions, and visual language into DESIGN.md without rendering or redesigning the interface."
        }
      },
      "rootFiles": [
        {
          "path": "LICENSE",
          "target": "stitch-skills-LICENSE.txt"
        }
      ],
      "excluded": {
        "code-to-design": "Requires the Stitch MCP server and multiple excluded Stitch workflow skills.",
        "extract-static-html": "Useful capture utility but not a design-analysis skill; excluded to keep the catalog focused.",
        "generate-design": "Requires the Stitch MCP server, which is not configured in this launcher.",
        "manage-design-system": "Requires the Stitch MCP server, which is not configured in this launcher.",
        "upload-to-stitch": "Requires Stitch credentials and the Stitch MCP workflow."
      }
    },
    {
      "id": "stitch-utilities",
      "repository": "https://github.com/google-labs-code/stitch-skills.git",
      "ref": "main",
      "skillRoot": "plugins/stitch-utilities/skills",
      "license": "Apache-2.0",
      "requireRootLicense": {
        "path": "LICENSE",
        "contains": "Apache License"
      },
      "include": [
        "enhance-prompt"
      ],
      "overrides": {
        "enhance-prompt": {
          "aliases": [
            "design_prompt",
            "stitch_prompt"
          ],
          "description": "Use when rewriting a vague UI request into a precise Google Stitch generation or editing prompt before UI generation, especially when layout, components, interactions, responsive behavior, or design-system constraints are underspecified."
        }
      },
      "compatibility": {
        "enhance-prompt": {
          "replacements": [
            {
              "path": "SKILL.md",
              "search": "💡 **Tip:** For consistent designs across multiple screens, create a DESIGN.md \r\nfile using the `design-md` skill. This ensures all generated pages share the \r\nsame visual language.",
              "replace": "💡 **Tip:** For consistent designs across multiple screens, create a DESIGN.md\r\nfile using the `design-md` skill. This ensures all generated pages share the\r\nsame visual language."
            },
            {
              "path": "SKILL.md",
              "search": "💡 **Tip:** For consistent designs across multiple screens, create a DESIGN.md \r\nfile using the `design-md` skill.",
              "replace": "💡 **Tip:** For consistent designs across multiple screens, create a DESIGN.md\r\nfile using the `design-md` skill."
            }
          ]
        }
      },
      "excluded": {
        "design-md": "Requires an existing Stitch project and Stitch MCP server; extract-design-md covers local source analysis.",
        "stitch-loop": "Requires Stitch and Chrome MCP servers and adds an autonomous workflow outside the requested design scope.",
        "taste-design": "Overlaps frontend-design but is less context-sensitive and imposes brittle universal rules such as mandatory perpetual motion and blanket font/layout bans."
      }
    },
    {
