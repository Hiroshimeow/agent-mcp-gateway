{
  "version": 1,
  "sources": [
    {
      "id": "ponytail",
      "repository": "https://github.com/DietrichGebert/ponytail.git",
      "ref": "main",
      "skillRoot": "skills",
      "license": "MIT",
      "requireRootLicense": {
        "path": "LICENSE",
        "contains": "MIT License"
      },
      "include": [
        "ponytail",
        "ponytail-audit",
        "ponytail-debt",
        "ponytail-gain",
        "ponytail-help",
        "ponytail-review"
      ],
      "rootFiles": [
        {
          "path": "LICENSE",
          "target": "ponytail-LICENSE.txt"
        }
      ]
    },
    {
      "id": "superpowers",
      "repository": "https://github.com/obra/superpowers.git",
      "ref": "main",
      "skillRoot": "skills",
      "license": "MIT",
      "requireRootLicense": {
        "path": "LICENSE",
        "contains": "MIT License"
      },
      "include": [
        "brainstorming",
        "dispatching-parallel-agents",
        "executing-plans",
        "finishing-a-development-branch",
        "receiving-code-review",
        "requesting-code-review",
        "subagent-driven-development",
        "systematic-debugging",
        "test-driven-development",
        "using-git-worktrees",
        "verification-before-completion",
        "writing-plans",
        "writing-skills"
      ],
      "compatibility": {
        "subagent-driven-development": {
          "replacements": [
            {
              "path": "SKILL.md",
              "search": "## Setup\n\nEnsure the work happens in an isolated workspace:",
              "replace": "## Setup\n\nIf the current task supplies its own orchestration or durable state, that task's orchestration and state are authoritative whenever they conflict with this skill.\n\nEnsure the work happens in an isolated workspace:"
            }
          ]
        },
        "executing-plans": {
          "replacements": [
            {
              "path": "SKILL.md",
              "replace": "- Your harness has no subagent tool. Never fabricate a dispatch; run the plan here.",
              "searchParts": [
                "- Your harness has no subagent tool (see the per-platform references in\n  `../",
                "using-",
                "superpowers",
                "/references/`). Never fabricate a dispatch; run\n  the plan here."
              ]
            }
          ]
        },
        "writing-skills": {
          "replacements": [
            {
              "path": "SKILL.md",
              "replace": "**Personal skills live in your runtime's configured skills directory.** For cross-runtime project-local skills, prefer `.agents/skills/` when the harness supports it.",
              "searchParts": [
                "**Personal skills live in your runtime's skills directory** (`~/.claude/skills/` on Claude Code) — see [codex-tools.md](../",
                "using-",
                "superpowers",
                "/references/codex-tools.md) or [gemini-tools.md](../",
                "using-",
                "superpowers",
                "/references/gemini-tools.md) for the path on those runtimes. Codex, Copilot CLI, and Gemini CLI all also recognize `~/.agents/skills/` as a cross-runtime alias."
              ]
            }
          ]
        }
      },
      "rootFiles": [
        {
          "path": "LICENSE",
          "target": "superpowers-LICENSE.txt"
        }
      ]
    },
    {
      "id": "anthropic",
      "repository": "https://github.com/anthropics/skills.git",
      "ref": "main",
      "skillRoot": "skills",
      "license": "Apache-2.0 per included skill",
      "include": [
        "algorithmic-art",
        "brand-guidelines",
        "claude-api",
        "frontend-design",
        "internal-comms",
        "mcp-builder",
        "skill-creator",
        "slack-gif-creator",
        "theme-factory",
        "web-artifacts-builder",
        "webapp-testing"
      ],
      "requireSkillLicense": {
        "path": "LICENSE.txt",
        "contains": "Apache License"
      },
      "rootFiles": [
        {
          "path": "THIRD_PARTY_NOTICES.md",
          "target": "anthropic-THIRD_PARTY_NOTICES.md"
        }
      ],
      "excluded": {
        "canvas-design": "Not vendored because its directory contains bundled font files.",
        "doc-coauthoring": "No redistributable license is declared in the skill directory.",
        "docx": "Anthropic source-available proprietary license prohibits redistribution.",
        "pdf": "Anthropic source-available proprietary license prohibits redistribution.",
        "pptx": "Anthropic source-available proprietary license prohibits redistribution.",
        "xlsx": "Anthropic source-available proprietary license prohibits redistribution."
      },
      "compatibility": {
        "claude-api": {
          "frontmatter": {
            "description": "Use when implementing, debugging, or answering questions about the Claude API or Anthropic SDK, including Claude model selection, parameters, streaming, tool use, MCP, agents, caching, token counting, or migration. Use when Claude or Anthropic is the target provider; do not use for other named LLM providers."
          },
          "cleanup": [
            {
              "path": "shared/platform-availability.md",
              "trimTrailingBlankLines": true
            }
          ]
        },
        "frontend-design": {
          "frontmatter": {
            "description": "Use when designing, building, or materially reshaping a web or application UI that needs visual direction, typography, layout, responsive behavior, interaction design, or implementation-level aesthetic decisions."
          }
        },
        "theme-factory": {
          "frontmatter": {
            "description": "Use when applying or generating a coherent visual theme for slides, documents, reports, or standalone artifacts whose content and structure already exist."
          }
        },
        "web-artifacts-builder": {
          "frontmatter": {
            "description": "Use when implementing a complex interactive HTML artifact with React, Tailwind CSS, shadcn/ui, routing, or state management after its requirements and visual direction are established."
          }
        }
      }
    },
    {
      "id": "stitch-design",
      "repository": "https://github.com/google-labs-code/stitch-skills.git",
      "ref": "main",
      "skillRoot": "plugins/stitch-design/skills",
      "license": "Apache-2.0",
      "requireRootLicense": {
        "path": "LICENSE",
        "contains": "Apache License"
      },
      "include": [
        "extract-design-md"
      ],
      "rootFiles": [
        {
          "path": "LICENSE",
          "target": "stitch-skills-LICENSE.txt"
        }
      ],
      "excluded": {
        "code-to-design": "Requires the Stitch MCP server and multiple excluded Stitch workflow skills.",
        "extract-static-html": "Useful capture utility but not a design-analysis skill; excluded to keep the catalog focused.",
        "generate-design": "Requires the Stitch MCP server, which is not configured in this launcher.",
        "manage-design-system": "Requires the Stitch MCP server, which is not configured in this launcher.",
        "upload-to-stitch": "Requires Stitch credentials and the Stitch MCP workflow."
      },
      "compatibility": {
        "extract-design-md": {
          "frontmatter": {
            "description": "Use when analyzing an existing frontend source tree to extract design tokens, component conventions, and visual language into DESIGN.md without rendering or redesigning the interface.",
            "name": "extract-design-md"
          }
        }
      }
    },
    {
      "id": "stitch-utilities",
      "repository": "https://github.com/google-labs-code/stitch-skills.git",
      "ref": "main",
      "skillRoot": "plugins/stitch-utilities/skills",
      "license": "Apache-2.0",
      "requireRootLicense": {
        "path": "LICENSE",
        "contains": "Apache License"
      },
      "include": [
        "enhance-prompt"
      ],
      "excluded": {
        "design-md": "Requires an existing Stitch project and Stitch MCP server; extract-design-md covers local source analysis.",
        "stitch-loop": "Requires Stitch and Chrome MCP servers and adds an autonomous workflow outside the requested design scope.",
        "taste-design": "Overlaps frontend-design but is less context-sensitive and imposes brittle universal rules such as mandatory perpetual motion and blanket font/layout bans."
      },
      "compatibility": {
        "enhance-prompt": {
          "frontmatter": {
            "description": "Use when rewriting a vague UI request into a precise Google Stitch generation or editing prompt before UI generation, especially when layout, components, interactions, responsive behavior, or design-system constraints are underspecified."
          },
          "cleanup": [
            {
              "path": "SKILL.md",
              "trimTrailingWhitespace": true
            }
          ]
        }
      }
    },
    {
